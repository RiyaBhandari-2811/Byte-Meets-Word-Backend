									"if (responseBody.hasOwnProperty('token')) {\r",
									"    // Extract the token from the response body\r",
									"    const authToken = responseBody.token;\r",
									"\r",
									"    // Save the token in an environment variable for later use\r",
									"    pm.environment.set('authToken', authToken);\r",
