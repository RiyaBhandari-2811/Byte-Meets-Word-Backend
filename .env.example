# -------------------------------
# 🌍 Application Configuration
# -------------------------------
# Base URL of your application (e.g., http://localhost:3000 or production URL)
BASE_URL=""

# -------------------------------
# 📧 Email Configuration
# -------------------------------
# SMTP settings for sending emails
EMAIL_FROM=""     # e.g., "noreply@yourdomain.com"
EMAIL_HOST=""     # e.g., "smtp.gmail.com"
EMAIL_PORT=""     # e.g., 587
EMAIL_USER=""     # your SMTP username or email
EMAIL_PASS=""     # your SMTP password or app-specific password

# -------------------------------
# 🔐 Authentication
# -------------------------------
# Secret key for signing JWT tokens (use a strong random string in production)
JWT_SECRET=""

# -------------------------------
# 🗄️ Database Configuration
# -------------------------------
# MongoDB connection string (Atlas or local)
MONGODB_URI=""

# -------------------------------
# ⚡ Redis Configuration
# -------------------------------
# Redis connection URL (default for local Docker)
REDIS_URL="redis://localhost:6379"

# -------------------------------
# ☁️ Vercel Configuration
# -------------------------------
# Vercel OIDC token (auto-provided in Vercel environment)
VERCEL_OIDC_TOKEN=""
